# Local settings file, read by scripts/setup.py and by the worker CLI on your machine.
# Git-ignored: never commit it. You can copy this file to .env, or let scripts/setup.py ask for the values
# and save them for you.
#
# Only these seven values are needed. Everything else (the webhook path, the app token key, function
# settings) is derived or has a default.

# Supabase project ref: the part before .supabase.co in your project URL
SUPABASE_PROJECT_REF=
# Supabase access token (supabase.com → Account → Access Tokens); used by the bootstrap workflow
SUPABASE_ACCESS_TOKEN=
# Supabase database password, chosen when the project was created
SUPABASE_DB_PASSWORD=
# Supabase service_role key (Project Settings → API Keys)
SUPABASE_SERVICE_ROLE_KEY=
# Bale bot token from BotFather
BALE_BOT_TOKEN=
# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional. Leave these commented to use the defaults.
# ALLOWED_ORIGINS=https://YOUR-GITHUB-USER.github.io
# MAX_DOWNLOAD_BYTES=52428800
# MAX_DOWNLOAD_ATTEMPTS=3
